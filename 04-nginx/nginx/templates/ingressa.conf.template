# O Nginx fica na frente do Ingressa: recebe todas as conexões e controla
# quantas requisições estão sendo atendidas ao mesmo tempo.
#
# ${MAX_COMPRAS_SIMULTANEAS} e ${MAX_MAPAS_SIMULTANEOS} vêm do docker-compose.yml.
#
# O limite é de requisições EM ANDAMENTO, não por segundo. Pela Lei de Little,
# vazão = em andamento ÷ tempo de cada uma: se o Ingressa (ou o cinema) fica
# mais rápido, as requisições terminam antes e entram mais por segundo; se
# fica mais lento, entram menos. O limite se adapta sozinho à capacidade real,
# e a espera dentro do Ingressa nunca passa de um certo tamanho.

limit_conn_zone $server_name zone=compras:1m;
# O mapa vem do cache, mas montá-lo ainda custa CPU do Ingressa
limit_conn_zone $server_name zone=mapas:1m;
limit_conn_status 429;

upstream ingressa {
    server ingressa:8000;
    keepalive 64;
}

server {
    listen 80;
    server_name ingressa;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;

    # O Ingressa não tem timeout nas chamadas externas; o Nginx também espera
    # para não mudar esse comportamento.
    proxy_read_timeout 600s;

    location = /pedidos {
        limit_conn compras ${MAX_COMPRAS_SIMULTANEAS};
        error_page 429 = @muita_gente;
        proxy_pass http://ingressa;
    }

    location ~ ^/sessoes/[0-9]+/assentos$ {
        limit_conn mapas ${MAX_MAPAS_SIMULTANEOS};
        error_page 429 = @muita_gente;
        proxy_pass http://ingressa;
    }

    location / {
        proxy_pass http://ingressa;
    }

    location @muita_gente {
        default_type application/json;
        return 429 '{"detail": "Muita gente comprando agora. Tente de novo em instantes."}';
    }
}
